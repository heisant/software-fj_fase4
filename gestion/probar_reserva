
from gestion.reserva import Reserva
from gestion.excepciones import (
    ClienteNoValidoError,
    ServicioNoValidoError,
    DuracionInvalidaError,
    EstadoReservaError,
    CalculoCostoError
)


# Servicio provisional para realizar las pruebas
class ServicioPrueba:

    def calcular_costo(self, duracion):
        tarifa = 50000
        return duracion * tarifa


# Crear objetos de prueba
servicio = ServicioPrueba()
cliente = "Carlos Pérez"

print("PRUEBA 1: Crear una reserva")

reserva = Reserva(1, cliente, servicio, 2)
print("Reserva creada correctamente.")


print("\nPRUEBA 2: Confirmar reserva")

print(reserva.confirmar())


print("\nPRUEBA 3: Procesar reserva")

costo = reserva.procesar()
print("Costo de la reserva:", costo)


print("\nPRUEBA 4: Mostrar información")

reserva.mostrar_informacion()


print("\nPRUEBA 5: Validar cliente")

try:
    Reserva(2, None, servicio, 2)
except ClienteNoValidoError as error:
    print("Excepción controlada:", error)


print("\nPRUEBA 6: Validar servicio")

try:
    Reserva(3, cliente, None, 2)
except ServicioNoValidoError as error:
    print("Excepción controlada:", error)


print("\nPRUEBA 7: Validar duración")

try:
    Reserva(4, cliente, servicio, -2)
except DuracionInvalidaError as error:
    print("Excepción controlada:", error)


print("\nPRUEBA 8: Procesar reserva pendiente")

try:
    reserva_pendiente = Reserva(5, cliente, servicio, 1)
    reserva_pendiente.procesar()
except EstadoReservaError as error:
    print("Excepción controlada:", error)
